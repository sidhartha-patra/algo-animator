{
  "title": "Two Sum — Target 9",
  "algorithm": "Hash Map",
  "problem": "Find indices in [2,7,11,15] summing to 9",
  "intuition": "Maintain a lookup table of past elements to evaluate the required complement in O(1).",
  "visual_metaphor": "Librarian with labeled drawers storing visited numbers.",
  "invariant": "All elements before index i are recorded in hash table with their 0-based indices.",
  "time_complexity": "O(N)",
  "space_complexity": "O(N)",
  "confidence": 1.0,
  "source_code": "public int[] TwoSum(int[] nums, int target)\n{\n    var seen = new Dictionary<int, int>();\n    for (int i = 0; i < nums.Length; i++)\n    {\n        int complement = target - nums[i];\n        if (seen.ContainsKey(complement))\n            return new int[] { seen[complement], i };\n        seen[nums[i]] = i;\n    }\n    return new int[0];\n}",
