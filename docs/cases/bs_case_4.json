{
  "title": "Binary Search — Target 5",
  "algorithm": "Binary Search",
  "problem": "Find index of target 5 in sorted array [2,4,6,8,10]",
  "intuition": "Halve the search space by probing the midpoint of the sorted range.",
  "visual_metaphor": "Detective eliminating half the rooms at each step.",
  "invariant": "Target is guaranteed to be within [left..right] if it exists in the array.",
  "time_complexity": "O(log N)",
  "space_complexity": "O(1)",
  "confidence": 1.0,
  "source_code": "public int BinarySearch(int[] nums, int target)\n{\n    int left = 0, right = nums.Length - 1;\n    while (left <= right)\n    {\n        int mid = left + (right - left) / 2;\n        if (nums[mid] == target) return mid;\n        if (nums[mid] < target) left = mid + 1;\n        else right = mid - 1;\n    }\n    return -1;\n}",
